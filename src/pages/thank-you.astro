---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Thank You',
  description: 'Thanks for reaching out to EcoDataWorks.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold">Thanks for reaching out</h1>
    <p class="mt-4 text-xl text-muted">
      We've received your message and will get back to you within 24-48 business hours.
    </p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-white">
      Back to home
    </a>
  </section>
</Layout>
