---
// NOTE: For a growing portfolio, consider migrating this to a content
// collection (similar to src/data/post/ for the blog) so each case study
// is its own file. This version hardcodes placeholder entries to start.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';

const metadata = {
  title: 'Portfolio',
  description: 'Selected environmental data consulting projects.',
};

const projects = [
  {
    title: 'Watershed Monitoring Dashboard',
    client: 'Municipal Water Authority [Placeholder]',
    summary: 'Built a real-time dashboard tracking water quality metrics across 12 monitoring stations. [Placeholder — replace with real project summary, methods, and outcome.]',
    tags: ['Data Monitoring', 'Dashboards'],
    image: '~/assets/images/project-1.jpg',
  },
  {
    title: 'Site Environmental Impact Assessment',
    client: 'Land Development Firm [Placeholder]',
    summary: 'Conducted a baseline environmental impact assessment ahead of permitting. [Placeholder — replace with real project summary, methods, and outcome.]',
    tags: ['Impact Assessment', 'Compliance'],
    image: '~/assets/images/project-2.jpg',
  },
  {
    title: 'ESG Data Pipeline & Reporting',
    client: 'Mid-size Manufacturer [Placeholder]',
    summary: 'Designed an automated pipeline feeding annual sustainability disclosures. [Placeholder — replace with real project summary, methods, and outcome.]',
    tags: ['Sustainability', 'ESG Reporting'],
    image: '~/assets/images/project-3.jpg',
  },
];
---

<Layout metadata={metadata}>

  <Hero tagline="Portfolio">
    <Fragment slot="title">Selected projects</Fragment>
    <Fragment slot="subtitle">
      A sample of the work we do. Client names and details below are placeholders
      pending case-study write-ups and client approval.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700">
          <Image src={project.image} alt={project.title} width={480} height={320} class="h-48 w-full object-cover" />
          <div class="p-5">
            <p class="text-xs uppercase tracking-wide text-accent">{project.client}</p>
            <h3 class="mt-1 text-lg font-bold">{project.title}</h3>
            <p class="mt-2 text-sm text-muted">{project.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs dark:bg-gray-800">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CallToAction
    title="Have a project in mind?"
    subtitle="Let's talk about what you're trying to measure or report on."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
