---
// NOTE: For a growing portfolio, consider migrating this to a content
// collection (similar to src/data/post/ for the blog) so each case study
// is its own file.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Portfolio',
  description: 'Selected environmental data consulting projects.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>

  <Hero tagline="Portfolio">
    <Fragment slot="title">Our portfolio is in progress</Fragment>
    <Fragment slot="subtitle">
      We're a new consultancy and are building out detailed case studies as projects wrap up
      and clients approve sharing their work. In the meantime, see our
      <a href="/services" class="text-accent underline">services</a> or
      <a href="/contact" class="text-accent underline">get in touch</a> to talk about your project directly.
    </Fragment>
  </Hero>

  <CallToAction
    title="Have a project in mind?"
    subtitle="Let's talk about what you're trying to measure or report on."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
