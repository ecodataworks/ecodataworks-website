---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'FAQ',
  description: 'Frequently asked questions about our environmental data consulting services.',
};
---

<Layout metadata={metadata}>

  <Hero tagline="FAQ" compact>
    <Fragment slot="title">Frequently asked questions</Fragment>
  </Hero>

  <FAQs
    columns={1}
    classes={{ container: 'pt-6! md:pt-8! lg:pt-10! pb-12! md:pb-16! lg:pb-20!' }}
    items={[
      {
        title: 'What industries do you typically work with?',
        description: 'Academics, state  or federal agencies, local governments, non-profit organizations, private sector companies, or really anyone with environmental data needs. We are registered vendors with several universities and SAM (System for Award Management) for government contracting. If you need a specific registration, please reach out so we can discuss options.',
      },
      {
        title: 'Do you work with clients outside our region?',
        description: 'Yes, most of our analysis and reporting work is remote. Any necessary site visits can be scoped separately.',
      },
      {
        title: 'How is a project typically priced?',
        description: 'It depends on scope, but projects are priced based on the complexity and duration of the work. Our hourly rate starts at $150/hour, but rates may vary based on the project\'s specific needs. See our Pricing page for details.',
      },
      {
        title: 'What data formats or sources can you work with?',
        description: 'We regularly work with sensor/IoT data, analytical lab results, remote sensing imagery, and GIS shapefiles.',
      },
      {
        title: 'Do you sign NDAs or handle confidential data?',
        description: 'Yes, we can work under NDA and follow standard data handling practices for sensitive environmental data.',
      },
    ]}
  />

</Layout>
