---
// NOTE: Check src/components/widgets/ for a Pricing.astro widget — if
// present, prefer that over this custom grid for consistent styling.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Pricing',
  description: 'Pricing and engagement structures for environmental data consulting.',
};

const tiers = [
  {
    name: 'Assessment',
    price: 'From $[X,XXX]',
    period: 'per project',
    description: 'One-off environmental data assessment or impact study.',
    features: [
      'Scoping call & data audit',
      'Single deliverable report',
      '2–4 week turnaround [Placeholder]',
    ],
  },
  {
    name: 'Ongoing Monitoring',
    price: '$[X,XXX]',
    period: 'per month',
    description: 'Continuous data monitoring, dashboards, and periodic reporting.',
    features: [
      'Live dashboard access',
      'Monthly summary report',
      'Priority support',
    ],
    highlighted: true,
  },
  {
    name: 'Custom Project',
    price: 'Custom quote',
    period: '',
    description: 'Larger-scope engagements: multi-site, regulatory, or ESG programs.',
    features: [
      'Dedicated project lead',
      'Custom data pipeline / modeling',
      'Flexible reporting cadence',
    ],
  },
];
---

<Layout metadata={metadata}>

  <Hero tagline="Pricing">
    <Fragment slot="title">Engagement options</Fragment>
    <Fragment slot="subtitle">
      Every project is scoped individually — these tiers give a general sense of structure and starting price.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-3">
      {tiers.map((tier) => (
        <div
          class={`rounded-xl border p-6 ${
            tier.highlighted
              ? 'border-accent shadow-lg'
              : 'border-gray-200 dark:border-gray-700'
          }`}
        >
          <h3 class="text-lg font-bold">{tier.name}</h3>
          <p class="mt-2 text-3xl font-extrabold">{tier.price}</p>
          {tier.period && <p class="text-sm text-muted">{tier.period}</p>}
          <p class="mt-4 text-sm text-muted">{tier.description}</p>
          <ul class="mt-4 space-y-2 text-sm">
            {tier.features.map((f) => (
              <li>✓ {f}</li>
            ))}
          </ul>
          <a
            href="/contact"
            class="mt-6 inline-block rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white"
          >
            Get started
          </a>
        </div>
      ))}
    </div>
  </section>

  <FAQs
    title="Pricing questions"
    columns={1}
    items={[
      {
        title: 'Why isn\'t exact pricing listed?',
        description: 'Scope varies a lot by site count, data volume, and regulatory context — we quote after a short scoping call.',
      },
      {
        title: 'Can we start with a smaller engagement first?',
        description: 'Yes — the Assessment tier is a common low-commitment starting point before moving to ongoing monitoring.',
      },
    ]}
  />

</Layout>
