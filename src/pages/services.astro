---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services',
  description: 'Environmental data consulting services: assessments, monitoring, compliance reporting, and more.',
};
---

<Layout metadata={metadata}>

  <Hero tagline="Services" compact>
    <Fragment slot="title">What we offer</Fragment>
    <Fragment slot="subtitle">
      Data-first environmental consulting, scoped to your project or ongoing operations.
    </Fragment>
  </Hero>

  <Features2
    columns={2}
    classes={{ container: 'pt-6! md:pt-8! lg:pt-10! pb-12! md:pb-16! lg:pb-20!' }}
    items={[
      {
        title: 'Technical Documentation & Reporting',
        description: 'Data Management Plans including Quality Assurance Project Plans (QAPPs), custom pages or websites (e.g., Quarto, GitBook, JupyterBook), reports structured to meet EPA, state, and local regulatory requirements.',
        icon: 'tabler:file-description-filled',
      },
      {
        title: 'Data Visualization & Dashboards',
        description: 'Custom visualizations and live dashboards for environmental data, including interactive maps, charts, and automated reports.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Quality Assurance & Quality Control',
        description: 'Quality assurance and quality control services to ensure data integrity and compliance with research and/or regulatory standards. Familiarity with environmental data standards such as EPA, USGS, and NOAA.',
        icon: 'tabler:file-check',
      },
      {
        title: 'GIS & Spatial Analysis',
        description: 'ArcGIS and R mapping and spatial analysis for environmental data, including geospatial data processing, spatial statistics, and map creation (e.g., Leaflet). Experience with Esri field data collection apps (Survey123, Field Maps, QuickCapture) and familiarity with open-source alternatives (QGIS, Mapbox).',
        icon: 'tabler:map',
      },
      {
        title: 'Statistical Analysis & Modeling',
        description: 'Statistical and predictive modeling built around your specific dataset and question using both R and Python.',
        icon: 'tabler:chart-histogram',
      },
      {
        title: 'Training in Data Skills & Tools',
        description: 'Training sessions to build expertise in environmental data analysis and visualization tools. Certified Instructor for The Carpentries curriculum (R, Python, Git, Data Management).',
        icon: 'tabler:brain',
      },
    ]}
  />

  <CallToAction
    title="Not sure which service fits?"
    subtitle="Tell us about your project and we'll recommend a starting point."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
