---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services',
  description: 'Environmental data consulting services: assessments, monitoring, compliance reporting, and more.',
};
---

<Layout metadata={metadata}>

  <Hero tagline="Services">
    <Fragment slot="title">What we offer</Fragment>
    <Fragment slot="subtitle">
      Data-first environmental consulting, scoped to your project or ongoing operations.
    </Fragment>
  </Hero>

  <Features2
    columns={2}
    items={[
      {
        title: 'Environmental Impact Assessments',
        description: 'Baseline studies and impact quantification for development, permitting, or internal review.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Data Monitoring & Dashboards',
        description: 'Custom pipelines and live dashboards for air, water, soil, or emissions data.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Regulatory Compliance Reporting',
        description: 'Reports structured to meet EPA, state, and local regulatory requirements.',
        icon: 'tabler:file-check',
      },
      {
        title: 'GIS & Spatial Analysis',
        description: 'Mapping, remote sensing, and spatial modeling for land and resource management.',
        icon: 'tabler:map',
      },
      {
        title: 'Sustainability & ESG Reporting',
        description: 'Data support for GRI, TCFD, and ISSB-aligned sustainability disclosures.',
        icon: 'tabler:report-analytics',
      },
      {
        title: 'Custom Data Modeling',
        description: 'Statistical and predictive modeling built around your specific dataset and question.',
        icon: 'tabler:brain',
      },
    ]}
  />

  <CallToAction
    title="Not sure which service fits?"
    subtitle="Tell us about your project and we'll recommend a starting point."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
