---
// NOTE: Confirm these widget component names against your cloned
// src/components/widgets/ folder — AstroWind versions have shipped
// slightly different widget sets over time.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Environmental Data Consulting',
  description: 'Data-driven environmental insight — assessments, monitoring, and reporting for organizations that need to prove their impact.',
};
---

<Layout metadata={metadata}>

  <Hero
    tagline="Environmental Data Consulting"
    image={{ src: '~/assets/images/hero-environment.jpg', alt: 'Environmental data visualization' }}
  >
    <Fragment slot="title">
      Turning environmental data into <span class="text-accent">actionable insight</span>
    </Fragment>
    <Fragment slot="subtitle">
      We help organizations measure, monitor, and report on environmental impact —
      backed by rigorous data science and domain expertise.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { amount: '50+', title: 'Projects delivered' },
      { amount: '12', title: 'Industries served' },
      { amount: '8', title: 'Years combined experience' },
      { amount: '100%', title: 'Data-driven' },
    ]}
  />

  <!-- Services teaser: links out to the full /services page -->
  <Features
    title="What we do"
    subtitle="A snapshot of our core services — see the full breakdown on our Services page."
    items={[
      {
        title: 'Environmental Impact Assessments',
        description: 'Quantify project-level impact with defensible, data-backed methods.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Data Monitoring & Dashboards',
        description: 'Real-time environmental monitoring pipelines and reporting dashboards.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Regulatory Compliance Reporting',
        description: 'Reports structured to meet EPA and regional regulatory requirements.',
        icon: 'tabler:file-check',
      },
    ]}
  >
    <Fragment slot="bg" />
  </Features>

  <Content
    title="Our approach"
    subtitle="Methodology"
    items={[
      { title: 'Collect', description: 'Rigorous, reproducible data collection protocols.' },
      { title: 'Validate', description: 'Statistical QA/QC before any number reaches a client.' },
      { title: 'Report', description: 'Clear, decision-ready deliverables — not just raw data.' },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold">Built on transparent, reproducible methods</h3>
      <p>
        Every engagement follows a documented data pipeline, from field collection or
        remote sensing intake through validation and final reporting.
      </p>
    </Fragment>
  </Content>

  <Steps
    title="How an engagement works"
    items={[
      { title: 'Step 1', description: 'Initial consultation & scoping call.' },
      { title: 'Step 2', description: 'Data collection / integration plan.' },
      { title: 'Step 3', description: 'Analysis, modeling, and validation.' },
      { title: 'Step 4', description: 'Delivery: report, dashboard, or ongoing monitoring.' },
    ]}
  />

  <FAQs
    title="Common questions"
    subtitle="See our full FAQ page for more detail."
    items={[
      {
        title: 'What industries do you work with?',
        description: 'Manufacturing, agriculture, municipal, and land development clients, among others.',
      },
      {
        title: 'Do you offer ongoing monitoring, or one-off projects?',
        description: 'Both — see our Pricing page for typical engagement structures.',
      },
    ]}
  />

  <CallToAction
    title="Ready to talk about your data?"
    subtitle="Book a free 30-minute scoping call."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
