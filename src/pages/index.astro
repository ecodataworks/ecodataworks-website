---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Headline from '~/components/ui/Headline.astro';

const metadata = {
  title: 'Environmental Data Consulting',
  description: 'Data-driven environmental insight: assessments, monitoring, and reporting for organizations that need to prove their impact.',
};

const contactActions = [{ text: 'Email Us', href: 'mailto:contact@ecodataworks.com', variant: 'accent' }];

// Abstract graphic (hand-drawn SVG, not a stock photo) built from the EcoDataWorks
// logo palette: leaf green, water blue, and a data/circuit node network in navy.
//
// TO OMIT THIS GRAPHIC ENTIRELY: remove the `image={heroGraphic}` prop from the
// <Hero ...> element below (search this file for "image={heroGraphic}") — Hero.astro
// only renders an image when one is passed in, so deleting that one prop is enough.
// You can also delete this whole `heroGraphic` constant afterward if you don't want
// the unused code sitting here, but removing the prop alone is enough to hide it.
const heroGraphic = `
<figure class="mx-auto max-w-5xl">
<svg viewBox="0 0 1200 675" xmlns="http://www.w3.org/2000/svg" class="mx-auto rounded-2xl w-full h-auto" role="img" aria-label="Abstract illustration blending environmental and data motifs">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#eef7f2"/>
      <stop offset="100%" stop-color="#e7f1f8"/>
    </linearGradient>
    <filter id="blurGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="60"/>
    </filter>
  </defs>

  <rect width="1200" height="675" rx="24" fill="url(#bgGrad)"/>

  <circle cx="260" cy="220" r="220" fill="#43A047" opacity="0.22" filter="url(#blurGlow)"/>
  <circle cx="940" cy="480" r="240" fill="#2E7CC4" opacity="0.20" filter="url(#blurGlow)"/>

  <path d="M0 520 Q150 480 300 520 T600 520 T900 520 T1200 520" fill="none" stroke="#2E7CC4" stroke-width="3" opacity="0.35"/>
  <path d="M0 560 Q150 520 300 560 T600 560 T900 560 T1200 560" fill="none" stroke="#0f766e" stroke-width="3" opacity="0.3"/>

  <g stroke="#0B1B2E" stroke-width="1.5" opacity="0.45">
    <line x1="180" y1="150" x2="320" y2="90"/>
    <line x1="320" y1="90" x2="470" y2="160"/>
    <line x1="180" y1="150" x2="230" y2="260"/>
    <line x1="470" y1="160" x2="560" y2="260"/>
    <line x1="230" y1="260" x2="380" y2="300"/>
    <line x1="380" y1="300" x2="560" y2="260"/>
    <line x1="560" y1="260" x2="700" y2="200"/>
    <line x1="700" y1="200" x2="850" y2="230"/>
    <line x1="850" y1="230" x2="960" y2="150"/>
    <line x1="700" y1="200" x2="760" y2="330"/>
    <line x1="760" y1="330" x2="900" y2="360"/>
    <line x1="380" y1="300" x2="420" y2="420"/>
  </g>
  <g fill="#0B1B2E">
    <circle cx="180" cy="150" r="6"/>
    <circle cx="320" cy="90" r="5"/>
    <circle cx="470" cy="160" r="6"/>
    <circle cx="230" cy="260" r="5"/>
    <circle cx="560" cy="260" r="6"/>
    <circle cx="700" cy="200" r="6"/>
    <circle cx="850" cy="230" r="5"/>
    <circle cx="960" cy="150" r="6"/>
    <circle cx="760" cy="330" r="5"/>
    <circle cx="900" cy="360" r="6"/>
    <circle cx="420" cy="420" r="5"/>
  </g>
  <g fill="#0f766e">
    <circle cx="380" cy="300" r="9"/>
    <circle cx="700" cy="200" r="9"/>
  </g>

  <path d="M150 560 C 140 470, 210 400, 300 380 C 260 460, 230 530, 150 560 Z" fill="#43A047" opacity="0.9"/>
  <path d="M150 560 C 190 500, 240 450, 300 380" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.6"/>

  <path d="M1000 470 C1000 500, 975 522, 950 522 C925 522, 900 500, 900 470 C900 440, 950 390, 950 390 C950 390, 1000 440, 1000 470 Z" fill="#2E7CC4" opacity="0.9"/>
</svg>
<figcaption class="mt-2 text-center text-xs text-muted dark:text-slate-400">Illustration generated by Claude</figcaption>
</figure>
`;

const approachSubtitle =
  'Every engagement follows a customized, documented, and reproducible pipeline, whether that\'s for data collection, statistical analysis, or automated quality-check workflows.';

const processSteps = [
  {
    title: 'Reach out',
    description: 'Email us or book a short call to describe your data, project, or reporting need. No commitment required.',
  },
  {
    title: 'Scoping call',
    description: 'We talk through your goals, existing data, timeline, and any requirements to understand what "done" looks like.',
  },
  {
    title: 'Proposal & scope agreement',
    description: 'You get a written scope, timeline, and hourly estimate before any billed work begins.',
  },
  {
    title: 'Progress checkpoints',
    description: 'What happens next depends on the project. We check in at agreed points along the way, so you always know where things stand.',
  },
  {
    title: 'Reporting, documentation & ongoing support',
    description: 'A clear, decision-ready deliverable, plus guidance on how to run and maintain what we hand off (e.g. how to run a workflow yourself), and the option to continue with ongoing support.',
  },
];
---

<Layout metadata={metadata}>

  <Hero
    tagline="Environmental Data Consulting"
    image={heroGraphic}
    actions={contactActions}
  >
    <Fragment slot="title">
      Turning environmental data into <span class="text-teal-700 dark:text-teal-400">actionable insight</span>
    </Fragment>
    <Fragment slot="subtitle">
      We help organizations manage, analyze, and report on environmental data,
      from raw field collection to QA/QC, statistical modeling, and regulator-ready deliverables.
    </Fragment>
  </Hero>

  <!-- Services teaser: links out to the full /services page -->
  <Features
    title="What we do"
    subtitle="A snapshot of our core services. See the full breakdown on our Services page."
    items={[
      {
        title: 'Technical Documentation & Reporting',
        description: 'QAPPs, data management plans, and clear, decision-ready reports, including documentation to support regulatory requirements when needed.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Data Visualization & Dashboards',
        description: 'Custom visualizations and live dashboards for environmental data, including interactive maps and automated reports.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'GIS & Spatial Analysis',
        description: 'ArcGIS and R-based mapping, spatial statistics, and field data collection with Survey123, Field Maps, and QGIS.',
        icon: 'tabler:map',
      },
      {
        title: 'QA/QC & Statistical Modeling',
        description: 'Data integrity checks against recognized standards (EPA, USGS, NOAA), plus statistical and predictive modeling in R and Python.',
        icon: 'tabler:chart-histogram',
      },
    ]}
  >
    <Fragment slot="bg" />
  </Features>

  <div class="relative text-center -mt-8 mb-8">
    <a href="/services" class="text-accent font-semibold hover:underline">See all services →</a>
  </div>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <Headline title="Our approach" subtitle={approachSubtitle} />

    <Headline
      title="How an engagement works"
      classes={{ container: 'mb-6 md:mb-8', title: 'text-xl md:text-2xl' }}
    />
    <ol class="mx-auto max-w-2xl space-y-7">
      {processSteps.map((step, index) => (
        <li class="flex gap-4 text-left">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-teal-700/10 text-sm font-bold text-teal-700 dark:bg-teal-400/10 dark:text-teal-400">
            {index + 1}
          </span>
          <div>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="mt-1 text-base text-muted dark:text-slate-300">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <CallToAction
    title="Ready to talk about your data?"
    subtitle="Reach out and we'll set up a scoping call."
    actions={contactActions}
  />

</Layout>
