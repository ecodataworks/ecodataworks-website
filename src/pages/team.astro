---
// NOTE: If AstroWind's widget set includes a dedicated Team.astro widget,
// prefer that over this hand-built grid — check src/components/widgets/
// after cloning. This version uses plain markup so it works regardless.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import consultant1 from '~/assets/images/consultant-1.jpg';
import consultant2 from '~/assets/images/consultant-2.jpg';

const metadata = {
  title: 'Our Team',
  description: 'Meet the consultants behind EcoDataWorks.',
};

const consultants = [
  {
    name: 'Raissa Mendonca',
    role: 'Co-Founder | Data Consultant',
    bio: 'Raissa has extensive experience in environmental data management, data quality assessment, \
          statistical analysis, and data visualization in R, Python, and off-the-shelf tools (e.g., ArcGIS Experience). \
          Raissa has built a strong foundation in workflow design and implementation, including automated data \
          harvesting, processing, and reporting, along with data stewardship practices \
          (e.g., <a href="https://www.go-fair.org/fair-principles/" target="_blank" rel="noopener noreferrer" class="text-teal-700 dark:text-teal-400 underline">FAIR</a>, \
          <a href="https://datascience.codata.org/articles/10.5334/dsj-2020-043" target="_blank" rel="noopener noreferrer" class="text-teal-700 dark:text-teal-400 underline">CARE</a>) and \
          database design. She is also competent in developing agentic coding solutions (e.g., agents, skills). \
          Raissa earned her PhD in Ecology from Kent State University in 2022 studying the \
          effects of metals on freshwater ecosystems and currently works as the lead data manager for an \
          environmental monitoring program. She is also a certified instructor with The Carpentries, \
          where she teaches data science skills to researchers and professionals.',
    credentials: [
      'Ph.D., Ecology',
      '<a href="https://carpentries.org/" target="_blank" rel="noopener noreferrer" class="text-teal-700 dark:text-teal-400 underline">The Carpentries</a> Certified Instructor',
    ],
    image: consultant1,
    bookingLink: 'https://calendar.app.google/2GZy4Ym5dXoSArV5A',
  },
  {
    name: 'Colleen Cosgrove',
    role: 'Co-Founder | Data Consultant',
    bio: "Colleen has expertise in data management, statistical analysis, and dashboard creation, \
          with proficiency in both R and Python. Colleen has wide-ranging experience in \
          everything from project design and statistical analysis to professional visualization outputs and \
          dashboard creation. Colleen earned her PhD in Ecology in 2022 studying community and ecosystem ecology \
          in terrestrial ecosystems. She went on to complete a postdoc in water quality around Lake Erie at the \
          National Center for Water Quality Research at Heidelberg University from 2023-2026 where she worked \
          with nutrient loading and data visualization in the form of a new data dashboard for the lab in \
          collaboration with federal and state agencies' goals.",
    credentials: ['Ph.D., Ecology', 'Former post-doctoral researcher, National Center for Water Quality Research, Heidelberg University'],
    image: consultant2,
    bookingLink: 'https://calendar.app.google/ufq5rB8LfCPkiPX5A',
  },
];
---

<Layout metadata={metadata}>

  <Hero tagline="Our Team" compact>
    <Fragment slot="title">The people behind the data</Fragment>
    <Fragment slot="subtitle">
      Two consultants, one shared focus: rigorous, decision-ready environmental data.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-5xl px-4 pt-8 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 sm:grid-cols-2">
      {consultants.map((person) => (
        <div class="text-center sm:text-left">
          <Image
            src={person.image}
            alt={person.name}
            width={320}
            height={320}
            class="mx-auto h-40 w-40 rounded-full object-cover sm:mx-0"
          />
          <h3 class="mt-6 text-xl font-bold">{person.name}</h3>
          <p class="text-accent font-medium">{person.role}</p>
          <p class="mt-3 text-muted" set:html={person.bio} />
          <ul class="mt-3 space-y-1 text-sm text-muted">
            {person.credentials.map((c) => (
              <li>• <Fragment set:html={c} /></li>
            ))}
          </ul>
          <a
            href={person.bookingLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block text-sm font-semibold text-teal-700 hover:underline dark:text-teal-400"
          >
            Book a 30-minute call with {person.name.split(' ')[0]} →
          </a>
        </div>
      ))}
    </div>
  </section>

  <CallToAction
    title="Want to work with us?"
    subtitle="Reach out to discuss your project."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
