---
// NOTE: If AstroWind's widget set includes a dedicated Team.astro widget,
// prefer that over this hand-built grid — check src/components/widgets/
// after cloning. This version uses plain markup so it works regardless.
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import consultant1 from '~/assets/images/consultant-1.jpg';
import consultant2 from '~/assets/images/consultant-2.jpg';

const metadata = {
  title: 'Our Team',
  description: 'Meet the consultants behind EcoDataWorks.',
};

const consultants = [
  {
    name: 'Raissa Mendonca',
    role: 'Co-Founder | Data Consultant',
    // TODO: Replace bio and credentials with real information about background, expertise, and experience.
    bio: 'Raissa leads data pipeline design and statistical modeling for monitoring and impact-assessment projects. [Placeholder — replace with real credentials, degrees, years of experience, notable prior work.]',
    credentials: ['Ph.D., Environmental Science [Placeholder]', 'GIS Certification [Placeholder]'],
    image: consultant1,
  },
  {
    name: 'Colleen Cosgrove',
    role: 'Co-Founder | Data Consultant',
    bio: "Colleen has expertise in data management, statistical analysis, and dashboard creation, \
          with proficiency in both R and Python. Colleen has wide-ranging experience in \
          everything from project design and statistical analysis to professional visualization outputs and \
          dashboard creation. Colleen earned her PhD in Ecology in 2022 studying community and ecosystem ecology \
          in terrestrial ecosystems. She went on to complete a postdoc in water quality around Lake Erie at the \
          National Center for Water Quality Research at Heidelberg University from 2023-2026 where she worked \
          with nutrient loading and data visualization in the form of a new data dashboard for the lab in \
          collaboration with federal and state agencies' goals.",
    credentials: ['Ph.D., Ecology', 'Former post-doctoral researcher, National Center for Water Quality Research, Heidelberg University'],
    image: consultant2,
  },
];
---

<Layout metadata={metadata}>

  <Hero tagline="Our Team">
    <Fragment slot="title">The people behind the data</Fragment>
    <Fragment slot="subtitle">
      <!-- TODO: Replace with a more compelling subtitle that highlights the team's expertise and mission. -->
      Two consultants, one shared focus: rigorous, decision-ready environmental data.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 sm:grid-cols-2">
      {consultants.map((person) => (
        <div class="text-center sm:text-left">
          <Image
            src={person.image}
            alt={person.name}
            width={320}
            height={320}
            class="mx-auto h-40 w-40 rounded-full object-cover sm:mx-0"
          />
          <h3 class="mt-6 text-xl font-bold">{person.name}</h3>
          <p class="text-accent font-medium">{person.role}</p>
          <p class="mt-3 text-muted">{person.bio}</p>
          <ul class="mt-3 space-y-1 text-sm text-muted">
            {person.credentials.map((c) => (
              <li>• {c}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <CallToAction
    title="Want to work with us?"
    subtitle="Reach out to discuss your project."
    actions={[{ text: 'Contact Us', href: '/contact' }]}
  />

</Layout>
